generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  AVAILABLE
  RENTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  price       Int
  description String      @db.Text
  facilities  String[]
  status      RoomStatus  @default(AVAILABLE)
  order       Int         @default(0)
  images      RoomImage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model RoomImage {
  id        String   @id @default(cuid())
  url       String
  isPrimary Boolean  @default(false)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Setting {
  id          String   @id @default("default")
  kosName     String   @default("EvaKos")
  ownerName   String   @default("Villa")
  whatsapp    String   @default("6281234567890")
  address     String?  @db.Text
  mapsUrl     String?  @db.Text
  updatedAt   DateTime @updatedAt
}
