# Database Neon PostgreSQL (Serverless)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://[USER]:[PASSWORD]@[ENDPOINT].us-east-1.aws.neon.tech/neondb?sslmode=require"

# Cloudinary Credentials (Upload Foto)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Session Secret
SESSION_SECRET="your-session-secret"
